{
  "name": "gameshipper",
  "version": "0.1.0",
  "description": "Turn any web game folder into Steam-ready Windows, Mac and Linux builds. Built for AI agents.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gameshipper/gameshipper.git" },
  "homepage": "https://github.com/gameshipper/gameshipper#readme",
  "bugs": { "url": "https://github.com/gameshipper/gameshipper/issues" },
  "keywords": ["game", "steam", "steamworks", "electron", "desktop", "packager", "html5", "webgl", "threejs", "phaser", "steam-deck", "itch", "capacitor", "mcp", "claude-code", "cli"],
  "type": "module",
  "bin": { "gameshipper": "bin/gameshipper.js" },
  "exports": {
    "./types": { "types": "./types/index.d.ts" },
    "./package.json": "./package.json"
  },
  "files": ["bin", "dist", "types"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/types/tsconfig.json",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.int.config.ts",
    "test:agent": "npm run build && node scripts/agent-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "20.3.0",
    "@modelcontextprotocol/server": "2.2.0",
    "electron": "44.4.5",
    "es-module-lexer": "3.0.2",
    "filenamify": "6.0.0",
    "koffi": "3.3.2",
    "parse5": "8.0.1",
    "png2icons": "2.0.1",
    "sharp": "0.35.5",
    "steamworks-ffi-node": "0.11.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
