# Text files are LF in the repo and in every checkout. Git for Windows would otherwise check them out with CRLF,
# which breaks the shell scripts and `#!` lines npm packs, and the tests that read files line by line.
* text=auto eol=lf

# Never text, whatever they look like.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.zip binary
*.gz binary
*.tgz binary
*.ogg binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary
*.node binary
